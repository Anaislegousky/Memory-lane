# Copiez ce fichier en `.env` pour lancer l'application en local.
# Ne commitez jamais `.env` : il est ignoré par git.
# Sur Vercel, ces mêmes variables se renseignent dans Settings → Environment Variables.

# --- Supabase (Project Settings → API) ---------------------------------------
# Valeurs PUBLIQUES : elles finissent dans le navigateur, c'est normal.
# La sécurité des données repose sur les règles RLS de la base.
VITE_SUPABASE_URL="https://VOTRE-PROJET.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# Mêmes valeurs, lues par le serveur.
SUPABASE_URL="https://VOTRE-PROJET.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# --- Secrets SERVEUR uniquement (jamais de préfixe VITE_ !) -------------------
# Clé secrète Supabase (sb_secret_... ou "service_role") : contourne la sécurité RLS.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."
# Secret qui protège la route de nettoyage des photos (au moins 32 caractères).
# Générer avec : openssl rand -hex 32
CRON_SECRET=""

# --- PostHog (facultatif, mesure d'audience UE) --------------------------------
# Clé publique du projet PostHog (phc_...). Laisser vide = aucune mesure d'audience,
# et la bannière de cookies ne s'affiche pas.
VITE_POSTHOG_KEY=""
VITE_POSTHOG_HOST="https://eu.i.posthog.com"

